# Data source: "mock" (local JSON file, dev only) or "dynamo"
DATA_SOURCE=mock

# Public site URL (used for canonical URLs, sitemap, emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Phase 4: Resend
RESEND_API_KEY=

# Cognito admin login (managed login, auth code + PKCE). Pool ID e.g. eu-north-1_AbC123,
# domain e.g. https://<prefix>.auth.eu-north-1.amazoncognito.com. Leave the secret empty if the app client has none.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_DOMAIN=

# Phase 7: DynamoDB
DYNAMODB_TABLE=
DYNAMODB_REGION=eu-north-1
# Local only (never set in Amplify): CLI profile with access to the table
# AWS_PROFILE=martand
